---
// Acento decorativo: esquema simplificado de circuito hidráulico (trazos
// ortogonales + nodos de válvula) que se "dibuja" al entrar en viewport vía
// DrawSVGPlugin (ver initDrawSVG en motion.js). Uso deliberadamente acotado:
// máximo 1-2 apariciones por página, como remate visual, no como patrón repetido.
interface Props {
  class?: string;
  [key: `data-${string}`]: string | undefined;
}
const { class: className, ...rest } = Astro.props;
---

<svg
  data-draw-scope
  viewBox="0 0 400 220"
  class:list={['pointer-events-none', className]}
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  {...rest}
>
  <path data-draw d="M10 40 H140 V10 H260" />
  <path data-draw d="M10 110 H90 V180 H210 V110 H320" />
  <path data-draw d="M260 10 V70 M320 110 V60 M320 60 H390" />
  <path data-draw d="M140 110 V40" />
  <path data-draw d="M210 180 V210 H340" />

  <circle data-draw cx="260" cy="10" r="6" />
  <circle data-draw cx="140" cy="110" r="6" />
  <circle data-draw cx="320" cy="110" r="6" />
  <circle data-draw cx="90" cy="180" r="4" fill="currentColor" stroke="none" />
  <circle data-draw cx="210" cy="110" r="4" fill="currentColor" stroke="none" />
  <circle data-draw cx="340" cy="210" r="6" />
  <rect data-draw x="300" y="50" width="20" height="20" rx="2" />
</svg>
