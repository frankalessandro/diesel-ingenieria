---
/*
 * Muro de clientes — reemplaza la barra de cifras de impacto del home.
 * Placa por empresa (sello técnico / wordmark; logo real cuando el cliente lo
 * entregue). Click/Enter abre un modal "Registro de cliente" con el detalle de
 * las intervenciones. Animación GSAP en scripts/motion.js -> initClientWall().
 *
 * Todo el contenido del modal se renderiza en el HTML (oculto) para que sea
 * indexable y accesible sin JS de plantillas; el script sólo lo muestra/anima.
 */
import { Image } from 'astro:assets';
import { clientes, tipoMeta } from '../data/clientes';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const totalIntervenciones = clientes.reduce((n, c) => n + c.intervenciones.length, 0);
const pad = (n: number) => String(n).padStart(2, '0');
---

<section
  class:list={['relative z-20 mx-auto -mt-8 max-w-7xl px-6 lg:-mt-12', className]}
  data-reveal-group
  aria-labelledby="clientwall-title"
>
  <div class="surface relative isolate overflow-hidden rounded-2xl">
    <div class="pointer-events-none absolute inset-0 blueprint-grid-fine opacity-70" aria-hidden="true"></div>
    <!-- barrido tipo escáner de medición (una sola pasada al entrar en viewport) -->
    <div
      class="client-scan pointer-events-none absolute inset-y-0 left-0 z-10 w-1/3 -translate-x-full opacity-0"
      data-client-scan
      aria-hidden="true"
    ></div>

    <!-- Encabezado -->
    <div class="reveal relative flex flex-col gap-3 border-b border-ink-900/10 bg-steel-50/60 px-6 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-8">
      <div>
        <span class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-oil-600">/ Clientes</span>
        <h2 id="clientwall-title" class="mt-1 font-display text-xl font-bold text-ink-900 sm:text-2xl">
          Empresas que ya operan con nuestro respaldo
        </h2>
      </div>
      <p class="shrink-0 font-mono text-xs uppercase tracking-[0.16em] text-ink-500">
        {pad(clientes.length)} empresas · {totalIntervenciones} intervenciones
      </p>
    </div>

    <!-- Grilla de placas -->
    <div class="relative grid grid-cols-1 divide-x divide-y divide-ink-900/8 sm:grid-cols-2 lg:grid-cols-3">
      {clientes.map((c) => (
        <button
          type="button"
          data-client-plate
          data-slug={c.slug}
          aria-haspopup="dialog"
          class="frame-corners corners-tight group relative flex cursor-pointer flex-col items-start gap-4 px-6 py-8 text-left transition-colors duration-200 hover:bg-steel-50 focus-visible:bg-steel-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-oil-500 sm:px-7 sm:py-9"
        >
          <span class="corner corner-tl transition-colors duration-200 group-hover:border-oil-500 group-focus-visible:border-oil-500"></span>
          <span class="corner corner-tr transition-colors duration-200 group-hover:border-oil-500 group-focus-visible:border-oil-500"></span>
          <span class="corner corner-bl transition-colors duration-200 group-hover:border-oil-500 group-focus-visible:border-oil-500"></span>
          <span class="corner corner-br transition-colors duration-200 group-hover:border-oil-500 group-focus-visible:border-oil-500"></span>

          <span class="font-mono text-[10px] font-medium uppercase tracking-[0.22em] text-ink-400">{c.code}</span>

          <span class="flex min-h-[3.25rem] w-full items-center">
            {c.logo ? (
              <Image
                src={c.logo}
                alt={`Logo ${c.name}`}
                width={280}
                height={140}
                class="h-12 w-auto max-w-[75%] object-contain object-left grayscale opacity-80 transition duration-200 group-hover:grayscale-0 group-hover:opacity-100"
              />
            ) : (
              <span class="font-display text-2xl font-bold leading-tight tracking-tight text-ink-800 transition-colors duration-200 group-hover:text-ink-900 sm:text-[1.65rem]">
                {c.name}
              </span>
            )}
          </span>

          <span class="h-px w-10 bg-ink-900/15 transition-all duration-300 group-hover:w-16 group-hover:bg-oil-500"></span>

          <span class="text-xs font-medium text-ink-500">{c.sector}</span>

          <span class="mt-1 flex items-center gap-3">
            <span class="flex items-center gap-1.5" aria-hidden="true">
              {c.intervenciones.map((iv) => (
                <span class:list={['iv-dot h-1.5 w-1.5 rounded-full', tipoMeta[iv.tipo].dot]}></span>
              ))}
            </span>
            <span class="inline-flex items-center gap-1 font-mono text-[11px] font-bold uppercase tracking-[0.12em] text-steel-700 opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100">
              Ver intervenciones
              <svg viewBox="0 0 20 20" class="h-3.5 w-3.5" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L11.29 6.16a.75.75 0 1 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 1 1-1.06-1.06l3.098-3.09H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/></svg>
            </span>
          </span>
          <span class="sr-only">Ver intervenciones realizadas para {c.name}</span>
        </button>
      ))}
    </div>
  </div>

  <!-- ============ MODAL ============ -->
  <div data-client-modal hidden class="fixed inset-0 z-[120] flex items-center justify-center p-4 sm:p-6">
    <div data-client-backdrop class="absolute inset-0 bg-ink-950/75 backdrop-blur-sm"></div>

    <div
      data-client-dialog
      role="dialog"
      aria-modal="true"
      aria-labelledby="cm-title"
      class="relative w-full max-w-2xl"
    >
      <!-- Wordmark gigante detrás del panel (mismo lenguaje que el watermark del hero) -->
      <span
        data-client-watermark
        aria-hidden="true"
        class="pointer-events-none absolute -top-8 left-1/2 z-0 -translate-x-1/2 select-none whitespace-nowrap font-display text-[13vw] font-bold leading-none text-stroke-oil opacity-60 sm:-top-11 sm:text-6xl"
      ></span>

      <div class="surface relative z-10 max-h-[85vh] overflow-y-auto rounded-2xl">
        <div class="hazard h-1.5 w-full" aria-hidden="true"></div>

        <div class="flex items-start justify-between gap-4 border-b border-ink-900/10 bg-steel-50 px-6 py-4 sm:px-8">
          <div>
            <span class="font-mono text-[11px] font-bold uppercase tracking-[0.18em] text-steel-700">
              Registro de cliente · Diesel Ingeniería S.A.S.
            </span>
            <h3 id="cm-title" data-cm-title class="mt-1 font-display text-2xl font-bold text-ink-900 sm:text-3xl"></h3>
            <p data-cm-sector class="mt-1 font-mono text-xs uppercase tracking-[0.12em] text-ink-500"></p>
          </div>
          <button
            type="button"
            data-client-close
            aria-label="Cerrar"
            class="flex h-9 w-9 shrink-0 cursor-pointer items-center justify-center rounded-full border border-ink-900/15 bg-white text-ink-600 transition-colors hover:border-oil-500 hover:text-oil-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-oil-500"
          >
            <svg viewBox="0 0 20 20" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"/></svg>
          </button>
        </div>

        <div class="px-6 py-6 sm:px-8">
          <p class="mb-5 font-mono text-[11px] uppercase tracking-[0.16em] text-ink-400">Intervenciones realizadas</p>
          <ol data-cm-list class="space-y-3"></ol>
        </div>

        <div class="flex flex-wrap items-center gap-x-2 gap-y-1 border-t border-ink-900/10 bg-steel-50/50 px-6 py-3.5 font-mono text-[11px] uppercase tracking-[0.14em] text-ink-500 sm:px-8">
          <span class="h-1.5 w-1.5 rounded-full bg-oil-500"></span>
          Intervención en sitio · Valle del Cauca
        </div>
      </div>
    </div>
  </div>

  <!-- Cuerpos del modal (ocultos, uno por cliente). El script copia el <ol> al modal. -->
  <div data-client-bodies hidden>
    {clientes.map((c) => (
      <ol data-client-body={c.slug} data-name={c.name} data-sector={c.sector}>
        {c.intervenciones.map((iv, i) => (
          <li data-cm-item class="relative flex gap-4 rounded-xl border border-ink-900/10 bg-white p-4 pl-5">
            <span class="absolute inset-y-3 left-0 w-0.5 rounded-full bg-oil-500" aria-hidden="true"></span>
            <span class="mt-0.5 shrink-0 font-display text-sm font-bold text-ink-200">{pad(i + 1)}</span>
            <div class="min-w-0">
              <span class:list={['inline-flex rounded-full border px-2.5 py-0.5 font-mono text-[10px] font-bold uppercase tracking-[0.12em]', tipoMeta[iv.tipo].chip]}>
                {tipoMeta[iv.tipo].label}
              </span>
              <p class="mt-2 text-sm leading-relaxed text-ink-700">{iv.text}</p>
            </div>
          </li>
        ))}
      </ol>
    ))}
  </div>
</section>
