---
import CircuitLine from './CircuitLine.astro';
import { company, maps, whatsappLink } from '../data/company';

const year = new Date().getFullYear();

// Íconos (paths de 24×24, trazo).
const ICON = {
  whatsapp: 'M12 21a9 9 0 1 0-7.9-4.7L3 21l4.8-1.3A8.9 8.9 0 0 0 12 21Z',
  pin: 'M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21Z',
};

const contactItems = [
  { label: 'WhatsApp', value: company.phones.whatsapp.display, href: whatsappLink(), external: true, icon: ICON.whatsapp },
  { label: 'Dirección', value: company.address, href: maps.link, external: true, icon: ICON.pin, ring: true },
];
---

<footer class="relative isolate overflow-hidden border-t border-ink-900/10 bg-paper-2">
  <CircuitLine class="pointer-events-none absolute -left-16 -top-10 hidden h-56 w-[30rem] text-steel-600/[0.07] md:block" aria-hidden="true" />

  <div class="relative mx-auto max-w-7xl px-6 py-16">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1.2fr] lg:gap-12">
      <!-- Marca -->
      <div>
        <a href="/" class="flex items-center gap-3" aria-label={`${company.name}, inicio`}>
          <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-br from-steel-600 to-steel-800 text-oil-400">
            <svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor" aria-hidden="true">
              <path d="M12 2c-.3 0-.6.13-.8.36C9.1 5.2 6 9.9 6 13.5 6 17.6 8.7 21 12 21s6-3.4 6-7.5c0-3.6-3.1-8.3-5.2-11.14A1.02 1.02 0 0 0 12 2Zm0 15.5a3.75 3.75 0 0 1-3.75-3.75.75.75 0 0 1 1.5 0A2.25 2.25 0 0 0 12 16a.75.75 0 0 1 0 1.5Z"/>
            </svg>
          </span>
          <span class="font-display text-lg font-bold tracking-wide text-ink-900">DIESEL INGENIERÍA S.A.S.</span>
        </a>

        <p class="mt-5 max-w-md text-sm leading-relaxed text-ink-600">
          {company.years} años de experiencia en Sistemas Hidráulicos y Neumáticos. Mantenimiento predictivo, preventivo y correctivo, fabricación de cilindros y unidades de potencia, y suministro de componentes — con servicio en sitio en {company.coverage}.
        </p>

        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a href="/#contacto" class="cursor-pointer rounded-lg bg-oil-500 px-6 py-3 text-sm font-bold text-ink-950 shadow-glow transition-colors hover:bg-oil-400">
            Solicitar diagnóstico
          </a>
          <a href={whatsappLink()} target="_blank" rel="noopener noreferrer" class="group inline-flex cursor-pointer items-center gap-2 rounded-lg border border-ink-900/15 bg-white px-6 py-3 text-sm font-bold text-ink-800 transition-colors hover:border-[#25D366] hover:text-[#128C4B]">
            <svg viewBox="0 0 24 24" class="h-4 w-4 text-[#25D366]" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.39 1.26 4.82L2 22l5.4-1.35a9.9 9.9 0 0 0 4.64 1.15c5.46 0 9.9-4.45 9.9-9.9C21.95 6.45 17.5 2 12.04 2Zm4.47 12c-.24.66-1.2 1.24-1.64 1.31-.42.06-.95.09-1.53-.1-.35-.11-.8-.26-1.38-.51-2.43-1.05-4.02-3.5-4.14-3.66-.12-.16-.99-1.32-.99-2.51s.63-1.78.85-2.02c.22-.24.48-.3.64-.3h.47c.15 0 .35-.01.55.42.21.49.7 1.7.76 1.82.06.12.1.26.02.42-.08.16-.12.26-.24.4-.13.16-.26.33-.37.42-.12.12-.25.25-.11.49.14.24.62 1.03 1.34 1.67.92.82 1.7 1.08 1.94 1.2.24.12.4.1.53-.06.14-.16.61-.71.77-.95.16-.24.33-.2.55-.12.23.08 1.43.67 1.67.79.24.12.4.18.46.28.06.1.06.59-.14 1.16Z"/></svg>
            {company.phones.whatsapp.display}
          </a>
        </div>

        <p class="mt-8 font-mono text-xs uppercase tracking-[0.16em] text-ink-500">{company.name} · NIT {company.nit}</p>
      </div>

      <!-- Contacto -->
      <div>
        <h3 class="font-display text-sm font-bold uppercase tracking-wider text-steel-700">Contacto directo</h3>
        <ul class="mt-5 space-y-4">
          {contactItems.map((item) => (
            <li>
              <a
                href={item.href}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
                class="group flex gap-3"
              >
                <svg viewBox="0 0 24 24" class="mt-0.5 h-5 w-5 shrink-0 text-oil-600" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d={item.icon}/>
                  {item.ring && <circle cx="12" cy="9.5" r="2.5"/>}
                </svg>
                <span>
                  <span class="block text-xs font-bold uppercase tracking-wider text-ink-500">{item.label}</span>
                  <span class="mt-1 block text-sm text-ink-700 transition-colors group-hover:text-oil-700">{item.value}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Ubicación -->
      <div>
        <h3 class="font-display text-sm font-bold uppercase tracking-wider text-steel-700">Ubicación</h3>
        <div class="mt-5 overflow-hidden rounded-xl border border-ink-900/10 shadow-card">
          <iframe
            title={`Ubicación de ${company.name} en Cali`}
            src={maps.embed}
            class="block h-44 w-full"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
        <a href={maps.link} target="_blank" rel="noopener noreferrer" class="mt-3 inline-flex cursor-pointer items-center gap-1.5 text-sm font-bold text-steel-700 hover:text-oil-700">
          Ver en Google Maps
          <svg viewBox="0 0 20 20" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L11.29 6.16a.75.75 0 1 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 1 1-1.06-1.06l3.098-3.09H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/></svg>
        </a>
        <p class="mt-3 text-xs leading-relaxed text-ink-500">
          Taller en {company.city}, {company.region}. Servicio en sitio en {company.coverage}.
        </p>
      </div>
    </div>

    <!-- Barra inferior -->
    <div class="mt-14 flex flex-col gap-2 border-t border-ink-900/10 pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-xs text-ink-500">© {year} {company.name} · NIT {company.nit}</p>
      <p class="text-xs text-ink-400">Sin redes sociales — escríbanos por WhatsApp o desde el formulario de contacto.</p>
    </div>
  </div>
</footer>
