---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SteelBanner from '../components/SteelBanner.astro';
import { categories } from '../data/especialidades';
---

<Layout
  title="Especialidades técnicas hidráulicas | Diesel Ingeniería S.A.S."
  description="Bombas, motores, válvulas, cilindros, acumuladores, filtración, neumática e instrumentación: los componentes que reparamos, mecanizamos y conseguimos para nuestros clientes en Colombia."
  path="/especialidades"
>
  <main>
    <PageHero
      kicker="Especialidades"
      title="Especialidades técnicas que dominamos"
      lead="No es una vitrina de venta: es el mapa de lo que conocemos a fondo. Reparamos, mecanizamos y conseguimos a nivel nacional cada uno de estos componentes para sus proyectos."
      watermark="TÉCNICA"
    />

    {/* Cada especialidad es una hoja de plano que se asienta sobre la anterior
        y deja el canto asomando. El apilado lo hace `position: sticky` (ver el
        <style> de abajo); GSAP sólo agrega el retroceso de la hoja que queda
        atrás — ver initSpecSheets() en scripts/motion.js. Con once categorías,
        pinear habría secuestrado el scroll varios miles de píxeles. */}
    <div class="spec-stack mx-auto max-w-6xl px-6 pb-32 pt-16" data-spec-stack>
      {categories.map((cat, i) => (
        <article
          id={cat.id}
          data-spec-sheet
          class="spec-sheet scroll-mt-32"
          style={`--i:${i}`}
        >
          <div class="sheet-body relative grid grid-cols-1 gap-5 p-5 sm:gap-8 sm:p-9 lg:grid-cols-[0.82fr_1.18fr] lg:gap-12">
            <span class="corner corner-tl" aria-hidden="true"></span>
            <span class="corner corner-tr" aria-hidden="true"></span>

            <div>
              <span class="flex h-13 w-13 items-center justify-center rounded-2xl bg-steel-50 text-steel-700">
                <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={cat.icon}/></svg>
              </span>
              <h2 class="mt-4 font-display text-2xl font-bold leading-tight text-ink-900 text-balance sm:text-3xl">{cat.title}</h2>
              <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-ink-600 sm:mt-3 sm:line-clamp-none sm:text-base">{cat.intro}</p>
              <a href="/#contacto" class="mt-5 flex w-fit cursor-pointer items-center gap-1.5 text-sm font-bold text-oil-700 hover:text-oil-600">
                ¿Necesita esto? Contáctenos
                <svg viewBox="0 0 20 20" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L11.29 6.16a.75.75 0 1 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 1 1-1.06-1.06l3.098-3.09H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/></svg>
              </a>
            </div>

            <ul class="grid grid-cols-2 content-start gap-2 sm:gap-2.5">
              {cat.items.map((item) => (
                <li class="rounded-xl border border-ink-900/8 bg-white/70 px-3 py-2.5 sm:px-4 sm:py-3">
                  <p class="text-[13px] font-semibold leading-snug text-ink-900 sm:text-base">{item.name}</p>
                  {item.specs && <p class="mt-1 font-mono text-[10px] leading-relaxed text-steel-600 sm:text-xs">{item.specs}</p>}
                </li>
              ))}
            </ul>
          </div>

          {/* Cajetín: la franja de datos que lleva todo plano técnico. */}
          <dl class="cajetin">
            <div>
              <dt>Empresa</dt>
              <dd>Diesel Ingeniería S.A.S.</dd>
            </div>
            <div>
              <dt>Líneas</dt>
              <dd>{cat.items.length} {cat.items.length === 1 ? 'línea de producto' : 'líneas de producto'}</dd>
            </div>
            <div>
              <dt>Servicio</dt>
              <dd>Reparación · Mecanizado · Suministro</dd>
            </div>
          </dl>
        </article>
      ))}
    </div>

    <SteelBanner width="narrow">
      <div class="frame-corners frame-corners-dark reveal relative overflow-hidden rounded-2xl border border-white/15 bg-white/[0.04] p-10 text-center sm:p-14">
        <span class="corner corner-tl" aria-hidden="true"></span>
        <span class="corner corner-tr" aria-hidden="true"></span>
        <span class="corner corner-bl" aria-hidden="true"></span>
        <span class="corner corner-br" aria-hidden="true"></span>

        <div class="relative">
          <span class="inline-flex items-center gap-2.5 rounded-full border border-oil-400/30 bg-oil-500/10 px-4 py-1.5 text-xs font-bold uppercase tracking-[0.2em] text-oil-400">
            <span class="h-1.5 w-1.5 rounded-full bg-oil-400"></span>
            ¿No lo encuentra en la lista?
          </span>
          <h2 class="mt-5 font-display text-4xl font-bold leading-tight text-balance sm:text-5xl">Búsquelo, lo conseguimos o lo reparamos</h2>
          <p class="mx-auto mt-4 max-w-xl text-lg text-steel-200/85">Trabajamos con marcas líderes del sector a nivel nacional. Cuéntenos qué necesita.</p>
          <ul class="mt-6 flex flex-wrap justify-center gap-2">
            {['Eaton', 'Rexroth', 'Parker', 'Vickers', 'Denison', 'Sun Hydraulics'].map((brand) => (
              <li class="spec-chip rounded-full px-3 py-1.5 text-xs font-semibold">{brand}</li>
            ))}
          </ul>
          <a href="/#contacto" class="mt-8 inline-block cursor-pointer rounded-lg bg-oil-500 px-7 py-4 text-sm font-bold text-ink-950 shadow-glow transition-colors hover:bg-oil-400">Contáctenos</a>
        </div>
      </div>
    </SteelBanner>
  </main>
</Layout>

<style>
  /* ---- Hojas de plano apiladas ---- */
  .spec-stack { display: grid; gap: 28px; }

  .spec-sheet {
    background: #fff;
    border: 1px solid rgb(14 22 32 / 0.12);
    border-radius: 6px;
    box-shadow: var(--shadow-card);
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    overflow: hidden;
    transform-origin: center top;
    /* El orden de pintado ya lo da el orden del DOM; esto lo deja explícito. */
    z-index: calc(var(--i) + 1);
  }

  /* Retícula de plano dentro del cuerpo de la hoja. */
  .spec-sheet .sheet-body {
    background-image:
      linear-gradient(rgb(27 81 130 / 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgb(27 81 130 / 0.055) 1px, transparent 1px);
    background-size: 24px 24px;
  }

  /* Esquinas de registro (sólo las superiores: el cajetín cierra abajo). */
  .spec-sheet .corner {
    position: absolute;
    width: 15px;
    height: 15px;
    pointer-events: none;
    border-color: rgb(27 81 130 / 0.35);
  }
  .spec-sheet .corner-tl { top: 12px; left: 12px; border-top: 2px solid; border-left: 2px solid; }
  .spec-sheet .corner-tr { top: 12px; right: 12px; border-top: 2px solid; border-right: 2px solid; }

  .cajetin {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) minmax(0, 1.3fr);
    border-top: 2px solid var(--color-ink-900);
    background: var(--color-paper);
    margin: 0;
  }
  .cajetin > div {
    padding: 11px 18px;
    border-right: 1px solid rgb(14 22 32 / 0.12);
    min-width: 0;
  }
  .cajetin > div:last-child { border-right: 0; }
  .cajetin dt {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ink-400);
  }
  .cajetin dd {
    margin: 3px 0 0;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-ink-800);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* El apilado: cada hoja se fija un poco más abajo que la anterior, así el
     canto de las que quedan atrás sigue a la vista. Va en todos los anchos —
     en mobile el desfase y el offset son menores porque hay menos pantalla. */
  @media (prefers-reduced-motion: no-preference) {
    /* Poco aire entre hojas: la pila tiene que leerse como una pila. */
    .spec-stack { gap: 26px; }
    .spec-sheet {
      position: sticky;
      top: calc(5.5rem + var(--i) * 4px);
    }
  }

  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .spec-stack { gap: 34px; }
    .spec-sheet { top: calc(7rem + var(--i) * 6px); }
  }

  /* En angosto la hoja tiene que caber entera en pantalla, si no el sticky
     deja de leerse como pila: cajetín en una sola fila de dos celdas, líneas
     de producto en dos columnas y todo más apretado. */
  @media (max-width: 1023px) {
    .spec-stack { padding-top: 2rem; }
    .cajetin { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .cajetin > div:nth-child(3) { display: none; }
    .cajetin > div { padding: 8px 14px; }
    .cajetin dd { font-size: 0.75rem; }
  }
</style>
