---
import Layout from '../layouts/Layout.astro';
import SteelBanner from '../components/SteelBanner.astro';
import MediaFrame from '../components/MediaFrame.astro';
import CircuitLine from '../components/CircuitLine.astro';
import BrandGrid from '../components/BrandGrid.astro';
import ClientWall from '../components/ClientWall.astro';
import { company, figures, whatsappLink } from '../data/company';
import { categories, totalItems } from '../data/especialidades';
import logoJohnDeere from '../assets/logos-marcas/john-deere-6-logo.svg';
import logoVolvo from '../assets/logos-marcas/volvo-logo.svg';
import logoCat from '../assets/logos-marcas/cat-logo-png-transparent.png';
import logoKomatsu from '../assets/logos-marcas/Komatsu-Logo.png';
import logoHitachi from '../assets/logos-marcas/Hitachi-Logo-1968.png';
import logoCase from '../assets/logos-marcas/case-logo-png-transparent.png';
import logoDoosan from '../assets/logos-marcas/Doosan-Logo-2022.png';
import logoZoomlion from '../assets/logos-marcas/zoomlion-logo-png_seeklogo-321945.png';
import logoTerex from '../assets/logos-marcas/Terex-logo.png';
import logoFord from '../assets/logos-marcas/ford.svg';

const wa = whatsappLink();

const specSheet = [
  { k: 'Especialidad', v: 'Hidráulica' },
  { k: 'Cobertura', v: company.coverage },
  { k: 'Fabricación', v: 'Cilindros y unidades de potencia' },
  { k: 'Servicio', v: 'En sitio' },
  { k: 'Mantenimiento', v: 'Predictivo, preventivo y correctivo' },
];

const whatWeDo = [
  {
    n: '01', span: 'lg:col-span-7', title: 'Mantenimiento Predictivo', tag: 'El diferenciador',
    desc: 'Medimos la eficiencia de bombas y motores con la máquina operando, sin desmontarla, para proyectar el desgaste antes de la falla.',
    href: '/servicios#predictivo',
    icon: 'M3 12h3l2-7 4 14 2-7h4',
  },
  {
    n: '02', span: 'lg:col-span-5', title: 'Mantenimiento Preventivo', tag: '',
    desc: 'Check-lists en sitio, microfiltrado de aceite y calibración de válvulas para mantener la disponibilidad del equipo.',
    href: '/servicios#preventivo',
    icon: 'M9 12l2 2 4-4M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
  },
  {
    n: '03', span: 'lg:col-span-5', title: 'Mantenimiento Correctivo', tag: '',
    desc: 'Reparación de bombas, motores, cilindros, válvulas, tarjetas electrónicas y tableros de control.',
    href: '/servicios#correctivo',
    icon: 'M14.7 6.3a4 4 0 0 1-5.4 5.4L4 17v3h3l5.3-5.3a4 4 0 0 0 5.4-5.4l-2.3 2.3-2-2 2.3-2.3Z',
  },
  {
    n: '04', span: 'lg:col-span-7', title: 'Fabricación a medida', tag: 'Construcción propia',
    desc: 'Cilindros hidráulicos, unidades de potencia con tablero eléctrico, de acuerdo con la necesidad del Cliente.',
    href: '/servicios#fabricacion',
    icon: 'M4 21h16M6 21V8l6-4 6 4v13M9 21v-5h6v5',
  },
];

// `short` es la etiqueta del componente en el esquema hidráulico; `x` es su
// posición sobre la línea de presión (mismo sistema de coordenadas del SVG).
const servicePanels = [
  { short: 'Predictivo', x: 300, title: 'Mantenimiento Predictivo', desc: 'Calculamos la eficiencia de bombas y motores con el equipo en su ciclo de trabajo, para proyectar el desgaste antes de la falla.', points: ['Medición con la máquina operando', 'Estanqueidad de cilindros en campo', 'Herramienta para mantenimiento'] },
  { short: 'Preventivo', x: 440, title: 'Mantenimiento Preventivo', desc: 'Ejecución de check-lists según la necesidad del cliente y el lugar donde se requiera, con técnicos capacitados y herramientas adecuadas.', points: ['Microfiltrado del aceite en sitio', 'Bloques de válvula calibrados', 'Mayor tiempo de operatividad'] },
  { short: 'Correctivo', x: 580, title: 'Mantenimiento Correctivo', desc: 'Reparación completa de la parte hidráulica y eléctrica de control.', points: ['Bombas, motores y cilindros', 'Válvulas y mandos direccionales', 'Tarjetas y tableros eléctricos'] },
  { short: 'Fabricación', x: 720, title: 'Fabricación a medida', desc: 'Fabricación de cilindros hidráulicos y unidades de potencia; construcción de centrales hidráulicas.', points: ['Cilindros y unidades de potencia', 'Tanques de 20 a 1.500 litros', 'Bancos de prueba'] },
  { short: 'Filtración', x: 860, title: 'Filtración', desc: 'Unidades de filtración portátiles propias, de alta eficiencia, para aceites muy viscosos, con servicio en el sitio del cliente.', points: ['Capacidad 27 a 55 L/min', 'Filtrado simple 10µ / doble 5µ', 'Indicador visual de saturación'] },
  { short: 'Suministro', x: 1000, title: 'Suministro de componentes', desc: 'Conseguimos y suministramos a nivel nacional los componentes hidráulicos que su equipo necesita, de las marcas líderes del sector.', points: ['Bombas, motores y válvulas', 'Marcas líderes del sector', 'Entrega a nivel nacional'] },
];

// Sectores atendidos — panel interactivo (radio-tabs sin JS). Antes vivía en
// /sectores; ahora es la sección 04 del index.
const sectors = [
  {
    id: 'industrial', n: '01', title: 'Industrial',
    lead: 'Sistemas hidráulicos para líneas de producción y procesos.',
    apps: ['Inyección de plásticos', 'Siderúrgica', 'Pulpa de papel y convertidoras', 'Industria metalúrgica', 'Industria química', 'Alimentos y bebidas', 'Automotriz', 'Petrolera'],
    icon: 'M4 21V9l8-6 8 6v12M9 21v-6h6v6',
  },
  {
    id: 'agricola', n: '02', title: 'Agrícola',
    lead: 'Mantenimiento y reparación para la maquinaria del campo.',
    apps: ['Tractores', 'Cosechadoras', 'Pulverizadoras', 'Alzadoras', 'Bulldozer', 'Excavadoras', 'Máquinas e implementos agrícolas en general'],
    icon: 'M12 3v9m0 0-3.5-3.5M12 12l3.5-3.5M5 21c0-4 3-7 7-7s7 3 7 7',
  },
  {
    id: 'construccion-mineria', n: '03', title: 'Construcción y minería',
    lead: 'Soporte para los equipos de mayor exigencia de presión y ciclo de trabajo.',
    apps: ['Retroexcavadoras', 'Cargadores', 'Percutores'],
    icon: 'M3 21h18M6 21V10l6-5 6 5v11M10 21v-6h4v6',
  },
  {
    id: 'forestal', n: '04', title: 'Forestal',
    lead: 'Kits hidráulicos y rotadores para el trabajo forestal.',
    apps: ['Cargadores forestales', 'Excavadoras forestales', 'Arrastradores', 'Forwarders', 'Cabezales y rotativos Baltrotors (1–16 toneladas)'],
    icon: 'M12 3 6 12h3l-4 6h5v3h4v-3h5l-4-6h3L12 3Z',
  },
  {
    id: 'portuaria-offshore', n: '05', title: 'Portuaria / Offshore',
    lead: 'Sistemas para operación marítima y petrolera.',
    apps: ['Plataformas offshore', 'Grúas', 'Industria petrolera', 'Aplicaciones portuarias varias'],
    icon: 'M3 20h18M4 20V9l4-2 4 2 4-2 4 2v11M8 12h.01M14 12h.01',
  },
  {
    id: 'manipulacion-cargas', n: '06', title: 'Manipulación de cargas',
    lead: 'Cilindros y centrales hidráulicas para equipos de elevación y traslado.',
    apps: ['Gatos hidráulicos', 'Mesas pantográficas', 'Elevadores', 'Apiladores', 'Canastas aéreas'],
    icon: 'M4 16h16M6 16V8h4v8M14 16V5h4v11',
  },
  {
    id: 'elevacion-alturas', n: '07', title: 'Elevación y Acceso en Alturas', full: 'Equipos de Elevación y Acceso en Alturas',
    lead: 'Cilindros y centrales hidráulicas para equipos de elevación y acceso en alturas.',
    apps: ['Grúas Canasta', 'Plataformas Elevadoras (Man Lift)'],
    icon: 'M12 3v18M7 8l5-5 5 5M5 21h14',
  },
  {
    id: 'infraestructura', n: '08', title: 'Infraestructura',
    lead: 'Sistemas hidráulicos para equipos de montaje y obra de infraestructura.',
    apps: ['Grúas de Brazo'],
    icon: 'M4 21V10l4-3 4 3v11M12 21V6l4-3 4 3v15M4 21h16',
  },
];

// Reglas CSS generadas por sector (radio-tabs sin JS): botón activo + panel visible.
const tabCss = sectors
  .map(
    (s) => `
    #tab-${s.id}:checked ~ .switch-scroller [data-btn="${s.id}"] { background-color: var(--color-oil-500); border-color: var(--color-oil-400); color: var(--color-ink-950); }
    #tab-${s.id}:checked ~ .switch-scroller [data-btn="${s.id}"] .btn-icon { background-color: rgb(8 13 19 / 0.14); color: var(--color-ink-950); }
    #tab-${s.id}:checked ~ .switch-scroller [data-btn="${s.id}"] .font-display { color: var(--color-ink-950); }
    #tab-${s.id}:checked ~ .frame-corners [data-panel="${s.id}"] { display: grid; }
    #tab-${s.id}:focus-visible ~ .switch-scroller [data-btn="${s.id}"] { outline: 2px solid var(--color-oil-400); outline-offset: 2px; }
    #tab-${s.id}:checked ~ .carousel-dots [data-dot="${s.id}"] { background-color: var(--color-oil-400); width: 1.1rem; border-radius: 9999px; }
  `,
  )
  .join('\n');

const projects = [
  { n: '01', span: 'lg:col-span-8', title: 'Mini centrales hidráulicas', desc: 'Tanques de 1 a 20 litros, bomba de engranaje de 0,5 a 7,3 cc, motor eléctrico de 12/24/110/220/380 V y potencias de 1 a 5 Cv, hasta 180 bar. Para canasta aérea, elevadores, camión remolque, mesa pantográfica y más.' },
  { n: '02', span: 'lg:col-span-4', title: 'Compactadoras de residuos', desc: 'Fabricación de sistemas hidráulicos para equipos compactadores.' },
  { n: '03', span: 'lg:col-span-4', title: 'Elevadores hidráulicos', desc: 'Elevadores de carga y de pasajeros, además de modernización de elevadores hidráulicos existentes.' },
  { n: '04', span: 'lg:col-span-8', title: 'Repotenciación de sistemas y equipos', desc: 'Actualización de equipos y tableros eléctricos de control para recuperar o mejorar el desempeño de sistemas hidráulicos que ya están en operación.' },
];

const brands = [
  { name: 'John Deere', logo: logoJohnDeere },
  { name: 'Volvo', logo: logoVolvo },
  { name: 'CAT', logo: logoCat },
  { name: 'Komatsu', logo: logoKomatsu },
  { name: 'Hitachi', logo: logoHitachi },
  { name: 'Case', logo: logoCase },
  { name: 'Doosan', logo: logoDoosan },
  { name: 'Zoom Lion', logo: logoZoomlion },
  { name: 'Terex', logo: logoTerex },
  { name: 'Ford', logo: logoFord },
];

const philosophy = [
  { title: 'Calidad', desc: 'Control en cada reparación, mecanizado y prueba en banco.', icon: 'M9 12l2 2 4-4M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z' },
  { title: 'Seguridad', desc: 'Trabajo seguro en taller y en intervenciones de campo.', icon: 'M12 3 5 6v6c0 4.5 3 7.5 7 9 4-1.5 7-4.5 7-9V6l-7-3ZM9 12l2 2 4-4' },
  { title: 'Medio ambiente', desc: 'Manejo responsable de aceites, filtros y residuos del mantenimiento.', icon: 'M12 3c-3 4-6 7-6 11a6 6 0 0 0 12 0c0-4-3-7-6-11Z' },
  { title: 'Mejora continua', desc: 'Actualización en técnicas de diagnóstico y tecnología del sector.', icon: 'M3 12a9 9 0 0 1 15-6.7L21 8M21 3v5h-5M21 12a9 9 0 0 1-15 6.7L3 16M3 21v-5h5' },
];

// ---- Contacto (sección final del index) ----
const serviceOptions = [
  'Mantenimiento predictivo',
  'Mantenimiento preventivo',
  'Mantenimiento correctivo',
  'Fabricación a medida',
  'Filtración y microfiltrado',
  'Suministro de componentes',
  'Otro / no estoy seguro',
];

const inputClass =
  'w-full rounded-lg border border-ink-900/15 bg-white px-3.5 py-2.5 text-sm text-ink-900 placeholder:text-ink-400 transition-colors focus:border-oil-500 focus:outline-none focus:ring-2 focus:ring-oil-500/30 aria-[invalid=true]:border-oil-600 aria-[invalid=true]:ring-oil-600/20';
---

<Layout
  title="Diesel Ingeniería S.A.S. | Sistemas Hidráulicos en Cali, Colombia"
  description="25 años en Sistemas Hidráulicos. Mantenimiento predictivo, preventivo y correctivo, fabricación y suministro de componentes. Cali, Suroccidente Colombiano y Eje Cafetero."
  path="/"
>
  <main>
    <!-- ============ HERO ============ -->
    <section data-hero data-parallax-scope class="noise relative isolate overflow-hidden bg-paper pt-32 pb-24 lg:pt-40">
      <div class="pointer-events-none absolute -right-24 -top-24 h-[38rem] w-[38rem] rounded-full bg-steel-200/45 blur-[130px]" data-parallax="0.2" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -left-32 bottom-[-6rem] h-96 w-96 rounded-full bg-oil-100/70 blur-[110px]" data-parallax="0.12" aria-hidden="true"></div>
      <CircuitLine class="pointer-events-none absolute -right-10 bottom-0 hidden h-64 w-[26rem] text-steel-600/[0.09] lg:block" data-parallax="0.06" aria-hidden="true" />
      <span class="pointer-events-none absolute -bottom-10 left-1/2 -translate-x-1/2 select-none whitespace-nowrap font-display text-[19vw] font-bold leading-none text-stroke opacity-70 sm:text-[15vw]" data-drift="10" aria-hidden="true">HIDRÁULICA</span>

      <div class="relative z-10 mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-14 px-6 lg:grid-cols-[1.15fr_0.85fr]">
        <div>
          <h1 class="font-display text-[12vw] font-bold leading-[0.96] tracking-tight text-ink-900 text-balance sm:text-6xl lg:text-[4.8rem]">
            <span data-hero-line data-gradient="sistemas" class="block">Especialistas en <span class="bg-linear-to-r from-oil-600 via-oil-500 to-oil-400 bg-clip-text uppercase text-transparent">Sistemas</span></span>
            <span data-hero-line data-gradient="hidráulicos" class="block bg-linear-to-r from-oil-600 via-oil-500 to-oil-400 bg-clip-text uppercase text-transparent">Hidráulicos</span>
          </h1>

          <p data-hero-sub class="mt-7 max-w-xl text-lg leading-relaxed text-ink-600">
            Diagnosticamos, reparamos y fabricamos sistemas hidráulicos movidos con aceite mineral utilizados en su maquinaria pesada e industrial.
          </p>

          <div class="mt-9 flex flex-wrap items-center gap-4">
            <a data-hero-cta href="/#contacto" class="cta-pulse cursor-pointer rounded-lg bg-oil-500 px-7 py-4 text-sm font-bold text-ink-950 shadow-glow transition-colors hover:bg-oil-400">
              Solicitar diagnóstico
            </a>
            <a data-hero-cta href={wa} target="_blank" rel="noopener noreferrer" class="group flex cursor-pointer items-center gap-2 rounded-lg border border-ink-900/15 bg-white px-7 py-4 text-sm font-bold text-ink-800 transition-colors hover:border-steel-500 hover:text-steel-700">
              Escribir por WhatsApp
              <svg viewBox="0 0 20 20" class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L11.29 6.16a.75.75 0 1 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 1 1-1.06-1.06l3.098-3.09H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/></svg>
            </a>
          </div>
        </div>

        <!-- Ficha técnica de la empresa -->
        <aside data-hero-side class="relative mx-auto w-full max-w-sm">
          <div class="surface overflow-hidden rounded-2xl">
            <div class="flex items-center justify-between border-b border-ink-900/10 bg-steel-50 px-6 py-4">
              <span class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-steel-700">Diesel Ingeniería S.A.S.</span>
              <span class="flex h-6 w-6 items-center justify-center rounded-full bg-oil-500 text-ink-950">
                <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="currentColor" aria-hidden="true"><path d="M12 2c-.3 0-.6.13-.8.36C9.1 5.2 6 9.9 6 13.5 6 17.6 8.7 21 12 21s6-3.4 6-7.5c0-3.6-3.1-8.3-5.2-11.14A1.02 1.02 0 0 0 12 2Z"/></svg>
              </span>
            </div>
            <div class="flex items-end gap-3 px-6 pt-6">
              <span class="font-display text-7xl font-bold leading-none text-ink-900"><span data-counter={figures.years}>0</span></span>
              <span class="pb-2 font-display text-sm font-bold uppercase tracking-[0.14em] text-oil-600">Años de<br>experiencia</span>
            </div>
            <dl class="mt-6 divide-y divide-ink-100 px-6 pb-6">
              {specSheet.map((row) => (
                <div class="flex items-center justify-between gap-4 py-2.5">
                  <dt class="font-mono text-xs uppercase tracking-wider text-ink-500">{row.k}</dt>
                  <dd class="text-right text-sm font-bold text-ink-800">{row.v}</dd>
                </div>
              ))}
            </dl>
          </div>
          <div class="absolute -bottom-3 -left-3 -z-10 h-24 w-24 rounded-xl hazard opacity-90" aria-hidden="true"></div>
        </aside>
      </div>
    </section>

    <!-- ============ CLIENTES (muro con modal) ============ -->
    <ClientWall />

    <!-- ============ ASÍ TRABAJAMOS (espacio de imagen) ============ -->
    <section class="mx-auto max-w-7xl px-6 pt-24" data-reveal-group>
      <div class="reveal grid grid-cols-1 items-center gap-10 lg:grid-cols-[1fr_1fr]">
        <MediaFrame ratio="4/3" label="Foto — Taller / Bahía de trabajo" class="order-2 lg:order-1" />
        <div class="order-1 lg:order-2">
          <span class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-oil-600">/ Así se ve el trabajo</span>
          <h2 class="mt-4 font-display text-3xl font-bold leading-tight text-ink-900 text-balance sm:text-4xl">Taller propio, técnicos en sitio</h2>
          <p class="mt-5 max-w-md leading-relaxed text-ink-600">
            Desde el banco de pruebas hidráulico hasta la intervención en campo: diagnóstico, mecanizado y reparación con equipo propio, respaldado por 25 años de trayectoria.
          </p>
          <a href="/nosotros" class="mt-7 inline-flex w-fit cursor-pointer items-center gap-1.5 text-sm font-bold text-steel-700 hover:text-oil-700">
            Conocer al equipo
            <svg viewBox="0 0 20 20" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L11.29 6.16a.75.75 0 1 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 1 1-1.06-1.06l3.098-3.09H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ============ QUÉ HACEMOS (bento asimétrico) ============ -->
    <section class="mx-auto max-w-7xl px-6 py-28" data-reveal-group>
      <div class="reveal flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl">
          <span class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-oil-600">/ 01 — Qué hacemos</span>
          <h2 class="mt-4 font-display text-4xl font-bold leading-tight text-ink-900 text-balance sm:text-5xl">Todo el ciclo del <span class="bg-linear-to-r from-oil-600 via-oil-500 to-oil-400 bg-clip-text uppercase text-transparent">sistema hidráulico</span></h2>
        </div>
        <p class="max-w-sm text-ink-600">Las tres gamas de mantenimiento más nuestra capacidad de fabricación de cilindros y unidades de potencia.</p>
      </div>

      <div class="mt-14 grid grid-cols-1 gap-5 lg:grid-cols-2">
        {whatWeDo.map((item) => (
          <a href={item.href} data-tilt="6" class="surface surface-hover tech-card reveal group flex cursor-pointer flex-col rounded-2xl p-8 sm:p-10">
            <div class="flex items-start justify-between">
              <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-steel-50 text-steel-700 transition-colors group-hover:bg-oil-500 group-hover:text-ink-950">
                <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={item.icon}/></svg>
              </span>
              <span class="card-index font-display text-4xl font-bold text-ink-100">{item.n}</span>
            </div>
            {item.tag && <span class="mt-6 w-fit rounded-full bg-oil-100 px-3 py-1 text-xs font-bold uppercase tracking-wider text-oil-700">{item.tag}</span>}
            <h3 class:list={["font-display font-bold text-ink-900", item.tag ? "mt-3 text-2xl" : "mt-6 text-xl"]}>{item.title}</h3>
            <p class="mt-3 flex-1 leading-relaxed text-ink-600">{item.desc}</p>
            <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-bold text-steel-700 transition-colors group-hover:text-oil-700">
              Ver más
              <svg viewBox="0 0 20 20" class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L11.29 6.16a.75.75 0 1 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 1 1-1.06-1.06l3.098-3.09H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/></svg>
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- ============ FEATURE: SIN DESMONTAR ============ -->
    <section data-parallax-scope class="noise relative isolate overflow-hidden border-y border-ink-900/10 bg-steel-50 py-28">
      <div class="absolute inset-0 dot-grid opacity-70" aria-hidden="true"></div>
      <span class="pointer-events-none absolute top-4 right-4 select-none whitespace-nowrap font-display text-[9vw] font-bold leading-none text-stroke-oil opacity-70 sm:-top-6 sm:text-[16vw]" data-drift="-10" aria-hidden="true">SIN DESMONTAR</span>

      <div class="relative z-10 mx-auto grid max-w-7xl grid-cols-1 items-center gap-16 px-6 lg:grid-cols-[1fr_0.85fr]">
        <div data-reveal-group>
          <span class="reveal font-mono text-xs font-bold uppercase tracking-[0.2em] text-oil-600">/ El diferenciador</span>
          <h2 class="reveal mt-5 font-display text-4xl font-bold leading-[1.05] text-ink-900 text-balance sm:text-6xl">
            Predecimos el desgaste <span class="text-oil-600">sin desmontar</span> la máquina
          </h2>
          <p class="reveal mt-6 max-w-lg text-lg leading-relaxed text-ink-600">
            Equipos de medición para calcular la eficiencia de bombas y motores hidráulicos sin necesidad de desmontarlos, entregando al departamento de mantenimiento una herramienta para proyectar el desgaste del equipo.
          </p>
          <ul class="reveal mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2">
            {['Diagnóstico con la máquina en marcha', 'Estanqueidad de cilindros en campo', 'Proyección del desgaste del equipo', 'Menos paradas no planificadas'].map((p) => (
              <li class="flex items-center gap-3 rounded-lg border border-ink-900/8 bg-white px-4 py-3 text-sm font-medium text-ink-700 shadow-card">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-oil-500/15 text-oil-700">
                  <svg viewBox="0 0 20 20" class="h-3.5 w-3.5" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 0 1 1.4-1.4l3.8 3.8 6.8-6.8a1 1 0 0 1 1.4 0Z" clip-rule="evenodd"/></svg>
                </span>
                {p}
              </li>
            ))}
          </ul>
        </div>

        <div data-hero-side class="relative mx-auto w-full max-w-md" aria-hidden="true">
          <div class="surface relative aspect-square rounded-3xl p-8">
            <svg viewBox="0 0 200 200" class="h-full w-full" data-draw-scope>
              <circle data-draw cx="100" cy="100" r="88" fill="none" stroke="rgb(14 22 32 / 0.08)" stroke-width="2"/>
              <circle data-draw cx="100" cy="100" r="70" fill="none" stroke="rgb(14 22 32 / 0.05)" stroke-width="1"/>
              {Array.from({ length: 44 }).map((_, i) => {
                const a = (i / 44) * 270 - 225;
                const r1 = i % 4 === 0 ? 62 : 68;
                const rad = (a * Math.PI) / 180;
                return (
                  <line
                    data-draw
                    x1={100 + r1 * Math.cos(rad)} y1={100 + r1 * Math.sin(rad)}
                    x2={100 + 74 * Math.cos(rad)} y2={100 + 74 * Math.sin(rad)}
                    stroke={i > 33 ? 'rgb(217 130 43 / 0.95)' : 'rgb(27 81 130 / 0.45)'} stroke-width={i % 4 === 0 ? 2.5 : 1}
                  />
                );
              })}
              <g class="gauge-needle" style="transform-origin:100px 100px">
                <line x1="100" y1="100" x2="150" y2="70" stroke="rgb(181 101 29)" stroke-width="3.5" stroke-linecap="round"/>
                <circle cx="100" cy="100" r="8" fill="rgb(181 101 29)"/>
                <circle cx="100" cy="100" r="3.5" fill="#fff"/>
              </g>
            </svg>
            <div class="absolute inset-x-0 bottom-8 text-center">
              <p class="font-mono text-xs uppercase tracking-[0.2em] text-steel-600">Medición en operación</p>
              <p class="mt-1 font-display text-lg font-bold text-ink-900">Eficiencia volumétrica y mecánica</p>
            </div>
          </div>
        </div>
      </div>

      <style>
        @keyframes needleSweep { 0%, 100% { transform: rotate(-8deg); } 50% { transform: rotate(14deg); } }
        .gauge-needle { animation: needleSweep 4s ease-in-out infinite; }
        @media (prefers-reduced-motion: reduce) { .gauge-needle { animation: none; } }
      </style>
    </section>

    <!-- ============ SERVICIOS — CIRCUITO HIDRÁULICO ============ -->
    {/* El esquema es la navegación: cada componente sobre la línea de presión
        es un servicio, y el scroll empuja el aceite por el circuito.

        Estructura: un track alto con un stage `position: sticky` adentro. El
        stage se queda quieto mientras el track pasa, y ese recorrido es el que
        alimenta la animación — el mismo mecanismo en desktop y en mobile, sin
        pin de GSAP (que en mobile es frágil).

        En mobile el SVG se dibuja más ancho que la pantalla y se desplaza en
        horizontal siguiendo el frente de presión, como un banner que paneo.
        Ver initServiceCircuit() en scripts/motion.js. */}
    <section data-circuit class="relative isolate bg-paper">
      <div class="circuit-dots pointer-events-none absolute inset-0" aria-hidden="true"></div>

      <div class="circuit-track relative z-10" data-circuit-track>
        <div class="circuit-stage" data-circuit-stage>
          <div class="mx-auto w-full max-w-6xl px-6">
            <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
              <div class="max-w-xl">
                <span class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-oil-600">/ 02 — Servicios</span>
                <h2 class="mt-3 font-display text-3xl font-bold leading-tight text-ink-900 text-balance sm:text-4xl lg:text-5xl">Seis frentes de trabajo</h2>
              </div>
              <div class="flex flex-col gap-4 sm:flex-row sm:items-center lg:shrink-0">
                <p class="max-w-xs text-sm text-ink-600">Desde anticipar una falla hasta suministrar el componente que la máquina necesita.</p>
                <a href="/servicios" class="inline-flex w-fit cursor-pointer items-center gap-2 rounded-lg bg-ink-900 px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-steel-700">
                  Ver servicios en detalle
                  <svg viewBox="0 0 20 20" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L11.29 6.16a.75.75 0 1 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 1 1-1.06-1.06l3.098-3.09H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/></svg>
                </a>
              </div>
            </div>

            {/* Esquema ISO 1219: tanque → bomba → línea de presión con los seis
                componentes → tanque de retorno. El wrapper recorta; el SVG se
                desplaza por dentro en pantallas angostas. */}
            <div class="circuit-viewport mt-7 lg:mt-10">
              <svg class="circuit" data-circuit-svg viewBox="0 0 1200 210" role="img"
                   aria-label="Esquema hidráulico con tanque, bomba y los seis servicios representados como componentes sobre la línea de presión.">
                <path class="c-line" d="M44 108 V174 H116 V108"/>
                <path class="c-line" d="M80 158 V60 H124"/>
                <text class="c-label" x="80" y="192" text-anchor="middle">Tanque</text>

                <circle class="c-line" cx="150" cy="60" r="26"/>
                <path class="c-solid" d="M143 50 L143 70 L164 60 Z"/>
                <text class="c-label" x="150" y="18" text-anchor="middle">Bomba</text>

                <path class="c-line" data-circuit-path d="M176 60 H1150 V110 H1096 V145"/>
                <path class="c-fill" data-circuit-fill d="M176 60 H1150 V110 H1096 V145"/>
                <text class="c-note" x="1146" y="44" text-anchor="end">{figures.pressureBar} bar</text>

                <path class="c-line" d="M1060 130 V196 H1132 V130"/>
                <text class="c-label" x="1096" y="186" text-anchor="middle">Retorno</text>

                <!-- Manómetro: medir con la máquina operando -->
                <g class="station" data-station="0">
                  <circle class="halo" cx="300" cy="60" r="46"/>
                  <rect class="box" x="274" y="34" width="52" height="52" rx="6"/>
                  <circle class="c-sym glyph" cx="300" cy="60" r="14"/>
                  <path class="c-sym glyph" d="M300 60 L309 51"/>
                  <path class="c-sym glyph" d="M289 50 L291 52 M311 50 L309 52"/>
                  <text class="c-label" x="300" y="112" text-anchor="middle">Predictivo</text>
                </g>
                <!-- Verificación: check-lists en sitio -->
                <g class="station" data-station="1">
                  <circle class="halo" cx="440" cy="60" r="46"/>
                  <rect class="box" x="414" y="34" width="52" height="52" rx="6"/>
                  <path class="c-sym glyph" d="M429 61 L437 69 L452 50"/>
                  <path class="c-sym glyph" d="M428 47 H444" stroke-width="1.4"/>
                  <text class="c-label" x="440" y="112" text-anchor="middle">Preventivo</text>
                </g>
                <!-- Motor hidráulico: triángulo hacia adentro (lo opuesto a la bomba) -->
                <g class="station" data-station="2">
                  <circle class="halo" cx="580" cy="60" r="46"/>
                  <rect class="box" x="554" y="34" width="52" height="52" rx="6"/>
                  <circle class="c-sym glyph" cx="580" cy="60" r="14"/>
                  <path class="c-solid glyph filled" d="M586 50 L586 70 L568 60 Z"/>
                  <text class="c-label" x="580" y="112" text-anchor="middle">Correctivo</text>
                </g>
                <!-- Cilindro de doble efecto con vástago -->
                <g class="station" data-station="3">
                  <circle class="halo" cx="720" cy="60" r="46"/>
                  <rect class="box" x="694" y="34" width="52" height="52" rx="6"/>
                  <rect class="c-sym glyph" x="702" y="49" width="24" height="22" rx="1.5"/>
                  <path class="c-sym glyph" d="M712 49 V71" stroke-width="3.6"/>
                  <path class="c-sym glyph" d="M712 60 H740" stroke-width="3"/>
                  <text class="c-label" x="720" y="112" text-anchor="middle">Fabricación</text>
                </g>
                <!-- Filtro ISO: rombo con línea punteada perpendicular al flujo -->
                <g class="station" data-station="4">
                  <circle class="halo" cx="860" cy="60" r="46"/>
                  <rect class="box" x="834" y="34" width="52" height="52" rx="6"/>
                  <path class="c-sym glyph" d="M860 45 L876 60 L860 75 L844 60 Z"/>
                  <path class="c-sym glyph" d="M860 45 V75" stroke-dasharray="3 3" stroke-width="1.6"/>
                  <text class="c-label" x="860" y="112" text-anchor="middle">Filtración</text>
                </g>
                <!-- Componentes en stock -->
                <g class="station" data-station="5">
                  <circle class="halo" cx="1000" cy="60" r="46"/>
                  <rect class="box" x="974" y="34" width="52" height="52" rx="6"/>
                  <rect class="c-sym glyph" x="985" y="45" width="12" height="12" rx="1.5"/>
                  <rect class="c-sym glyph" x="1001" y="45" width="12" height="12" rx="1.5"/>
                  <rect class="c-sym glyph" x="993" y="61" width="12" height="12" rx="1.5"/>
                  <text class="c-label" x="1000" y="112" text-anchor="middle">Suministro</text>
                </g>

                <circle class="front-halo" data-circuit-halo cx="176" cy="60" r="11" opacity="0"/>
                <circle class="front-dot" data-circuit-dot cx="176" cy="60" r="5" opacity="0"/>
              </svg>
            </div>

            {/* Un solo panel para todos los tamaños: cambia con la estación activa. */}
            <div class="surface mx-auto mt-6 grid w-full max-w-5xl grid-cols-1 items-start gap-6 rounded-2xl p-6 sm:p-8 lg:mt-8 lg:grid-cols-2 lg:gap-12">
              <div>
                <h3 data-circuit-title class="font-display text-xl font-bold text-ink-900 sm:text-2xl lg:text-3xl">{servicePanels[0].title}</h3>
                <p data-circuit-desc class="mt-2.5 max-w-md leading-relaxed text-ink-600">{servicePanels[0].desc}</p>
              </div>
              <ul data-circuit-points class="grid gap-2.5 lg:gap-3">
                {servicePanels[0].points.map((p) => (
                  <li class="flex items-start gap-3 border-b border-ink-100 pb-2.5 text-sm font-medium text-ink-700 last:border-0 last:pb-0 lg:pb-3">
                    <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-oil-500"></span>{p}
                  </li>
                ))}
              </ul>
            </div>

            <div class="mt-5 h-[3px] max-w-xs overflow-hidden rounded-full bg-ink-200 lg:mt-6">
              <div class="h-full w-full origin-left scale-x-0 rounded-full bg-oil-500" data-circuit-progress></div>
            </div>
          </div>
        </div>
        {/* Hermano en flujo normal que le da recorrido al stage pegajoso. No
            sirve padding en el track: el sticky se constriñe al content-box,
            que sin este spacer mide exactamente lo mismo que el stage. */}
        <div class="circuit-spacer" aria-hidden="true"></div>
      </div>

      {/* Única fuente de verdad para el panel: motion.js lee de acá en vez
          de duplicar los textos en el script. */}
      <script type="application/json" data-circuit-data set:html={JSON.stringify(servicePanels)}></script>
    </section>

    <!-- ============ ESPECIALIDADES — ÍNDICE DE DESPIECE ============ -->
    {/* El despiece es el documento nativo del oficio: una lista de partes con
        su conteo de líneas. Contrasta a propósito con las secciones de tarjetas
        que tiene alrededor, y sale de src/data/especialidades.ts — las mismas
        familias que despliega la página /especialidades. */}
    <section data-parallax-scope class="relative isolate overflow-hidden border-y border-ink-900/10 bg-white py-28">
      <span class="pointer-events-none absolute -top-2 right-0 select-none whitespace-nowrap font-display text-[15vw] font-bold leading-none text-stroke opacity-80" data-drift="-12" aria-hidden="true">DESPIECE</span>

      <div class="relative z-10 mx-auto max-w-7xl px-6" data-reveal-group>
        <div class="grid grid-cols-1 gap-12 lg:grid-cols-[0.82fr_1.18fr] lg:items-start">
          <div class="reveal lg:sticky lg:top-28">
            <span class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-oil-600">/ 03 — Especialidades</span>
            <h2 class="mt-4 font-display text-4xl font-bold leading-tight text-ink-900 text-balance sm:text-5xl">Si mueve aceite, <span class="text-oil-600">lo conocemos</span></h2>
            <p class="mt-5 leading-relaxed text-ink-600">
              Once familias de componentes hidráulicos y neumáticos. Los reparamos, los mecanizamos y los conseguimos
              a nivel nacional: no vendemos catálogo, resolvemos el equipo que está parado.
            </p>

            <dl class="mt-8 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-ink-900/10 bg-ink-900/10">
              <div class="bg-white px-5 py-4">
                <dt class="font-mono text-[10px] uppercase tracking-[0.18em] text-ink-400">Familias</dt>
                <dd class="mt-1 font-display text-3xl font-bold text-ink-900"><span data-counter={categories.length}>0</span></dd>
              </div>
              <div class="bg-white px-5 py-4">
                <dt class="font-mono text-[10px] uppercase tracking-[0.18em] text-ink-400">Líneas de producto</dt>
                <dd class="mt-1 font-display text-3xl font-bold text-ink-900"><span data-counter={totalItems}>0</span></dd>
              </div>
            </dl>

            <a href="/especialidades" class="mt-7 inline-flex cursor-pointer items-center gap-2 rounded-lg bg-oil-500 px-6 py-3.5 text-sm font-bold text-ink-950 shadow-glow transition-colors hover:bg-oil-400">
              Ver todas las especialidades
              <svg viewBox="0 0 20 20" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L11.29 6.16a.75.75 0 1 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 1 1-1.06-1.06l3.098-3.09H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/></svg>
            </a>
          </div>

          <div class="reveal surface overflow-hidden rounded-2xl">
            <div class="flex items-center justify-between gap-4 border-b border-ink-900/10 bg-steel-50 px-6 py-3.5">
              <span class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-steel-700">Índice de componentes</span>
              <span class="font-mono text-[11px] uppercase tracking-[0.14em] text-ink-400">Reparación · Mecanizado · Suministro</span>
            </div>

            <ul class="divide-y divide-ink-100">
              {categories.map((cat) => (
                <li>
                  <a
                    href={`/especialidades#${cat.id}`}
                    class="despiece-row group grid cursor-pointer grid-cols-[auto_1fr_auto] items-center gap-x-5 px-6 py-3.5 transition-colors hover:bg-steel-50"
                  >
                    <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-steel-50 text-steel-700 transition-colors group-hover:bg-oil-500 group-hover:text-ink-950">
                      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={cat.icon}/></svg>
                    </span>

                    {/* Sólo el nombre y el conteo: el índice tiene que abrir el
                        apetito, no saciarlo. El detalle vive en /especialidades. */}
                    <span class="min-w-0 font-display text-lg font-bold text-ink-900">{cat.title}</span>

                    <span class="flex shrink-0 items-center gap-3">
                      <span class="font-mono text-xs font-bold tabular-nums text-steel-600">
