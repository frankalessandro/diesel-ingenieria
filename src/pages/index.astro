<style>
  /* ---- Selector de sectores (banda azul) ---- */
  /* Crecimiento leve al hover: señala que la tarjeta es un botón sin empujar el
     layout (solo transform). */
  .switch-btn {
    transition:
      transform 0.28s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.2s ease,
      background-color 0.2s ease,
      box-shadow 0.28s ease;
  }
  .switch-btn:hover {
    border-color: rgb(217 130 43 / 0.5);
    background-color: rgb(255 255 255 / 0.14);
    transform: translateY(-3px) scale(1.025);
    box-shadow: 0 10px 24px -12px rgb(8 13 19 / 0.55);
  }
  .switch-btn:active {
    transform: translateY(-1px) scale(1.01);
  }
  @media (prefers-reduced-motion: reduce) {
    .switch-btn {
      transition: border-color 0.2s ease, background-color 0.2s ease;
    }
    .switch-btn:hover,
    .switch-btn:active {
      transform: none;
      box-shadow: none;
    }
  }

  /* Carrusel de sectores en mobile: sin scrollbar visible, snap suave */
  .switch-grid {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .switch-grid::-webkit-scrollbar {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .switch-grid {
      scroll-behavior: smooth;
    }
  }

  /* Difumina el borde derecho real del carrusel (sin parche de color superpuesto) */
  @media (max-width: 639px) {
    .switch-grid {
      -webkit-mask-image: linear-gradient(to left, transparent 0, #000 40px);
      mask-image: linear-gradient(to left, transparent 0, #000 40px);
      transition: -webkit-mask-image 0.3s, mask-image 0.3s;
    }
    .switch-grid.is-at-end {
      -webkit-mask-image: none;
      mask-image: none;
    }
  }

  /* Se oculta cuando el carrusel llega al final (sin más contenido a la derecha) */
  .scroll-hint.is-at-end {
    opacity: 0;
  }

  /* ---- Esquema hidráulico de la sección Servicios ---- */
  .circuit-dots {
    background-image: radial-gradient(rgb(27 81 130 / 0.14) 1.1px, transparent 1.1px);
    background-size: 22px 22px;
    -webkit-mask-image: radial-gradient(120% 90% at 50% 42%, #000 20%, transparent 78%);
    mask-image: radial-gradient(120% 90% at 50% 42%, #000 20%, transparent 78%);
  }

  /* --- Track alto + stage pegajoso: el recorrido del track es el que
         alimenta la animación, en desktop y en mobile por igual. --- */
  .circuit-track { position: relative; }
  /* El recorrido que el stage "consume" quieto mientras se anima. */
  .circuit-spacer { height: 260vh; }
  .circuit-stage {
    position: sticky;
    top: 6.5rem;
    padding-block: 0 2rem;
  }

  /* Recorta el esquema; en pantallas angostas el SVG es más ancho que esto
     y se desplaza por dentro siguiendo el frente de presión. */
  .circuit-viewport { overflow: hidden; }
  .circuit { display: block; height: auto; width: 100%; will-change: transform; }

  /* Angosto: el esquema se dibuja a tamaño legible y paneo en horizontal. */
  @media (max-width: 1023px) {
    .circuit { width: 860px; max-width: none; }
    .circuit-spacer { height: 300vh; }
  }

  @media (min-width: 1024px) {
    .circuit-stage { top: 7rem; padding-block: 2rem 2.5rem; }
    .circuit-spacer { height: 240vh; }
  }

  /* Sin movimiento: nada de track ni sticky, todo en flujo. */
  @media (prefers-reduced-motion: reduce) {
    .circuit-spacer { display: none; }
    .circuit-stage { position: static; }
    .circuit { width: 100%; }
    .circuit-viewport { overflow-x: auto; }
  }

  .c-line  { fill: none; stroke: rgb(27 58 92 / 0.26); stroke-width: 2.5; }
  .c-fill  { fill: none; stroke: var(--color-oil-500); stroke-width: 3.5; stroke-linecap: round; }
  .c-sym   { fill: none; stroke: var(--color-steel-700); stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
  .c-solid { fill: var(--color-steel-700); stroke: none; }

  .c-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    fill: var(--color-ink-400);
    text-transform: uppercase;
  }
  .c-note {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.1em;
    fill: var(--color-steel-600);
  }

  /* La caja va rellena para que la tubería "entre" y "salga" del componente. */
  .station .box {
    fill: #fff;
    stroke: rgb(27 58 92 / 0.3);
    stroke-width: 2;
    transition: stroke 0.35s ease, fill 0.35s ease;
  }
  .station .glyph { transition: stroke 0.35s ease, fill 0.35s ease; }
  .station .c-label { transition: fill 0.35s ease; }
  .station .halo { fill: var(--color-oil-500); opacity: 0; transition: opacity 0.4s ease; }

  .station.is-on .box { stroke: var(--color-oil-500); fill: var(--color-oil-100); }
  .station.is-on .glyph { stroke: var(--color-oil-700); }
  .station.is-on .glyph.filled { fill: var(--color-oil-700); stroke: none; }
  .station.is-on .c-label { fill: var(--color-oil-700); }
  .station.is-on .halo { opacity: 0.14; }

  .front-dot  { fill: var(--color-oil-500); }
  .front-halo { fill: var(--color-oil-500); }


</style>

<script>
  // Pista de scroll lateral del selector de sectores (solo mobile): se apaga al
  // llegar al final del carrusel.
  const track = document.querySelector<HTMLElement>('.switch-grid');
  const hint = document.querySelector<HTMLElement>('.scroll-hint');
  if (track && hint) {
    const updateHint = () => {
      const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
      hint.classList.toggle('is-at-end', atEnd);
      track.classList.toggle('is-at-end', atEnd);
    };
    track.addEventListener('scroll', updateHint, { passive: true });
    updateHint();
  }
</script>

<script>
  // Formulario de contacto: validación por campo + arma un mensaje de WhatsApp.
  // No hay backend — el mensaje viaja por el WhatsApp del visitante.
  const form = document.getElementById('contacto-form') as HTMLFormElement | null;

  if (form) {
    const field = (name: string) =>
      document.getElementById('c-' + name) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null;
    const errEl = (name: string) => document.getElementById('err-' + name);

    const rules: Record<string, (v: string) => true | string> = {
      nombre: (v) => v.trim().length >= 2 || 'Ingrese su nombre.',
      telefono: (v) => v.replace(/\D/g, '').length >= 7 || 'Ingrese un teléfono de contacto válido.',
      correo: (v) => v.trim() === '' || /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim()) || 'El correo no parece válido.',
      servicio: (v) => v !== '' || 'Seleccione un tipo de servicio.',
      mensaje: (v) => v.trim().length >= 10 || 'Describa el equipo y la falla (mínimo 10 caracteres).',
    };

    const validate = (name: string): boolean => {
      const el = field(name);
      if (!el) return true;
      const res = rules[name](el.value);
      const ok = res === true;
      const box = errEl(name);
      if (box) {
        box.textContent = ok ? '' : (res as string);
        box.hidden = ok;
      }
      el.setAttribute('aria-invalid', ok ? 'false' : 'true');
      return ok;
    };

    Object.keys(rules).forEach((name) => {
      const el = field(name);
      el?.addEventListener('blur', () => validate(name));
      el?.addEventListener('input', () => {
        const box = errEl(name);
        if (box && !box.hidden) validate(name);
      });
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      // Honeypot: si un bot lo llena, cortamos en silencio.
      const trap = document.getElementById('c-web') as HTMLInputElement | null;
      if (trap && trap.value.trim() !== '') return;

      const results = Object.keys(rules).map(validate);
      if (results.includes(false)) {
        (form.querySelector('[aria-invalid="true"]') as HTMLElement | null)?.focus();
        return;
      }

      const val = (name: string) => (field(name)?.value ?? '').trim();
      const lines = [
        `Hola ${form.dataset.name ?? 'Diesel Ingeniería S.A.S.'}, solicito un diagnóstico/cotización:`,
        `Nombre: ${val('nombre')}`,
        val('empresa') && `Empresa: ${val('empresa')}`,
        `Teléfono: ${val('telefono')}`,
        val('correo') && `Correo: ${val('correo')}`,
        `Servicio: ${val('servicio')}`,
        `Detalle: ${val('mensaje')}`,
      ].filter(Boolean) as string[];

      const url = `https://wa.me/${form.dataset.wa}?text=${encodeURIComponent(lines.join('\n'))}`;
      window.open(url, '_blank', 'noopener,noreferrer');

      const ok = document.getElementById('form-ok');
      const link = ok?.querySelector('[data-wa-link]') as HTMLAnchorElement | null;
      if (link) link.href = url;
      form.hidden = true;
      if (ok) ok.hidden = false;
      form.reset();
    });
  }
</script>
