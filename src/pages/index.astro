                      </span>
                      <svg viewBox="0 0 20 20" class="h-4 w-4 text-ink-300 transition-[transform,color] group-hover:translate-x-1 group-hover:text-oil-600" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L11.29 6.16a.75.75 0 1 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 1 1-1.06-1.06l3.098-3.09H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/></svg>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
    <!-- ============ SECTORES — PANEL DE CONTROL (banda azul) ============ -->
    <SteelBanner id="sectores" padding="py-28" class="scroll-mt-24">
      <div class="reveal flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl">
          <span class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-oil-400">/ 04 — Sectores</span>
          <h2 class="mt-4 font-display text-4xl font-bold leading-tight text-white text-balance sm:text-5xl">Donde se mueve la industria colombiana</h2>
          <p class="mt-5 max-w-xl leading-relaxed text-steel-200/80">
