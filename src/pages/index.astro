          <div class="scroll-hint pointer-events-none absolute inset-y-0 right-1 flex items-center pb-1 transition-opacity duration-300 sm:hidden" aria-hidden="true">
            <span class="animate-scroll-hint flex h-7 w-7 items-center justify-center rounded-full bg-steel-900/80 text-white shadow-lift ring-1 ring-white/15 backdrop-blur-sm">
              <svg viewBox="0 0 20 20" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.5 4.5 12.5 10l-5 5.5"/></svg>
            </span>
          </div>
        </div>

        <div class="carousel-dots mt-4 flex justify-center gap-1.5 sm:hidden" aria-hidden="true">
          {sectors.map((s) => (
            <span data-dot={s.id} class="dot h-1.5 w-1.5 rounded-full bg-white/20 transition-colors duration-200"></span>
          ))}
        </div>

        <div class="frame-corners frame-corners-dark relative mt-4 overflow-hidden rounded-2xl border border-white/15 bg-white/[0.03]">
          <span class="corner corner-tl" aria-hidden="true"></span>
          <span class="corner corner-tr" aria-hidden="true"></span>
          <span class="corner corner-bl" aria-hidden="true"></span>
          <span class="corner corner-br" aria-hidden="true"></span>

          {sectors.map((s) => (
            <div data-panel={s.id} class="sector-panel relative hidden w-full grid-cols-1 md:grid-cols-[1fr_0.85fr_1.1fr]">
              <div class="flex flex-col justify-between p-8 sm:p-10">
                <div>
                  <span class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-oil-400">Sector / {s.n}</span>
                  <h3 class="mt-2 font-display text-2xl font-bold leading-tight text-white sm:text-3xl">{s.full ?? s.title}</h3>
                  <p class="mt-4 leading-relaxed text-steel-200/85">{s.lead}</p>
