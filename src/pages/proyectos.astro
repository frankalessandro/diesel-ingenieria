---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SteelBanner from '../components/SteelBanner.astro';

const projects = [
  {
    n: '01', span: 'lg:col-span-8', title: 'Mini centrales hidráulicas',
    desc: 'Tanques de 1 a 20 litros, bomba de engranaje de 0,5 a 7,3 cc, motor eléctrico de 12/24/110/220/380 V y potencias de 1 a 5 Cv, hasta 180 bar.',
    apps: ['Canasta aérea', 'Elevadores', 'Camión remolque', 'Mesa pantográfica', 'Muelles', 'Cigüeña', 'Roll on / roll off'],
  },
  {
    n: '02', span: 'lg:col-span-4', title: 'Compactadoras de residuos',
    desc: 'Fabricación de sistemas hidráulicos para equipos compactadores.',
  },
  {
    n: '03', span: 'lg:col-span-4', title: 'Elevadores hidráulicos',
    desc: 'Elevadores de carga y de pasajeros, además de modernización de elevadores hidráulicos existentes.',
  },
  {
    n: '04', span: 'lg:col-span-8', title: 'Repotenciación de sistemas',
    desc: 'Actualización de equipos y tableros eléctricos de control para recuperar o mejorar el desempeño de sistemas hidráulicos que ya están en operación.',
  },
];
---

<Layout
  title="Proyectos de fabricación hidráulica | Diesel Ingeniería"
  description="Compactadoras de residuos, elevadores hidráulicos, repotenciación de sistemas y mini centrales hidráulicas por Diesel Ingeniería en Colombia."
  path="/proyectos"
>
  <main>
    <PageHero
      kicker="Proyectos"
      title="Fabricación e ingeniería aplicada"
      lead="Proyectos de fabricación e ingeniería hidráulica para clientes industriales y de aplicación móvil."
      watermark="PROYECTOS"
    />

    <section class="mx-auto max-w-7xl px-6 py-24" data-reveal-group>
      <div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
        {projects.map((p) => (
          <div class="surface surface-hover tech-card reveal flex flex-col rounded-2xl p-8 sm:p-10">
            <div class="flex items-start justify-between">
              <h2 class="max-w-md font-display text-2xl font-bold text-ink-900">{p.title}</h2>
              <span class="card-index font-display text-5xl font-bold text-ink-100">{p.n}</span>
            </div>
            <p class="mt-4 leading-relaxed text-ink-600">{p.desc}</p>
            {p.apps && (
              <ul class="mt-6 flex flex-wrap gap-2">
                {p.apps.map((app) => (
                  <li class="spec-chip rounded-full px-3 py-1.5 text-xs font-semibold">{app}</li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </div>
    </section>

    <section class="noise relative overflow-hidden border-y border-ink-900/10 bg-steel-50 py-24">
      <div class="absolute inset-0 dot-grid opacity-70" aria-hidden="true"></div>
      <div class="relative z-10 mx-auto max-w-4xl px-6 text-center" data-reveal-group>
        <span class="reveal font-mono text-xs font-bold uppercase tracking-[0.2em] text-oil-600">/ Aplicación industrial y móvil</span>
        <h2 class="reveal mt-4 font-display text-4xl font-bold leading-tight text-ink-900 text-balance sm:text-5xl">Camiones canasta, líneas eléctricas y más</h2>
        <p class="reveal mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-ink-600">
          Diseñamos soluciones hidráulicas para el sector industrial en general y para equipos móviles especializados, como camiones canasta usados en mantenimiento de líneas eléctricas.
        </p>
      </div>
    </section>

    <SteelBanner width="narrow" class="text-center">
      <h2 class="reveal font-display text-4xl font-bold leading-tight text-balance sm:text-5xl">¿Tiene un proyecto en mente?</h2>
      <p class="reveal mx-auto mt-4 max-w-xl text-lg text-steel-200/85">Cuéntenos qué necesita fabricar o repotenciar.</p>
      <a href="/contacto" class="reveal mt-8 inline-block cursor-pointer rounded-lg bg-oil-500 px-7 py-4 text-sm font-bold text-ink-950 shadow-glow transition-colors hover:bg-oil-400">Contáctenos</a>
    </SteelBanner>
  </main>
</Layout>
