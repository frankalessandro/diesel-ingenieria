---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';

const sectors = [
  {
    id: 'industrial', n: '01', title: 'Industrial',
    lead: 'Sistemas óleo-hidráulicos para líneas de producción y procesos.',
    apps: ['Inyección de plásticos', 'Siderúrgica', 'Pulpa de papel y convertidoras', 'Industria metalúrgica', 'Industria química', 'Alimentos y bebidas', 'Automotriz', 'Petrolera'],
    icon: 'M4 21V9l8-6 8 6v12M9 21v-6h6v6',
  },
  {
    id: 'agricola', n: '02', title: 'Agrícola',
    lead: 'Mantenimiento y reparación para la maquinaria del campo.',
    apps: ['Tractores', 'Cosechadoras', 'Pulverizadoras', 'Máquinas e implementos agrícolas en general'],
    icon: 'M12 3v9m0 0-3.5-3.5M12 12l3.5-3.5M5 21c0-4 3-7 7-7s7 3 7 7',
  },
  {
    id: 'construccion-mineria', n: '03', title: 'Construcción y minería',
    lead: 'Soporte para los equipos de mayor exigencia de presión y ciclo de trabajo.',
    apps: ['Construcción civil', 'Manipulación de carga', 'Máquinas viales', 'Equipos mineros'],
    icon: 'M3 21h18M6 21V10l6-5 6 5v11M10 21v-6h4v6',
  },
  {
    id: 'forestal', n: '04', title: 'Forestal',
    lead: 'Kits hidráulicos y rotadores para el trabajo forestal.',
    apps: ['Cargadores forestales', 'Excavadoras forestales', 'Arrastradores', 'Forwarders', 'Cabezales y rotativos Baltrotors (1–16 toneladas)'],
    icon: 'M12 3 6 12h3l-4 6h5v3h4v-3h5l-4-6h3L12 3Z',
  },
  {
    id: 'portuaria-offshore', n: '05', title: 'Portuaria / Offshore',
    lead: 'Sistemas para operación marítima y petrolera.',
    apps: ['Plataformas offshore', 'Grúas', 'Industria petrolera', 'Aplicaciones portuarias varias'],
    icon: 'M3 20h18M4 20V9l4-2 4 2 4-2 4 2v11M8 12h.01M14 12h.01',
  },
  {
    id: 'manipulacion-cargas', n: '06', title: 'Manipulación de cargas',
    lead: 'Cilindros y centrales hidráulicas para equipos de elevación y traslado.',
    apps: ['Gatos hidráulicos', 'Mesas pantográficas', 'Elevadores', 'Apiladores', 'Canastas aéreas'],
    icon: 'M4 16h16M6 16V8h4v8M14 16V5h4v11',
  },
];
---

<Layout
  title="Sectores atendidos | Diesel Ingeniería"
  description="Sistemas óleo-hidráulicos para los sectores industrial, agrícola, construcción, minería, forestal, portuario/offshore y manipulación de cargas en Colombia."
  path="/sectores"
>
  <main>
    <PageHero
      kicker="Sectores"
      title="Donde se mueve la industria colombiana"
      lead="Cada sector exige su propio criterio de presión, ciclo y ambiente de trabajo. Adaptamos diagnóstico, reparación y fabricación a la realidad de cada máquina."
      watermark="SECTORES"
    />

    <div class="mx-auto max-w-7xl px-6 py-24">
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-2" data-reveal-group>
        {sectors.map((s, i) => (
          <section id={s.id} class:list={["surface surface-hover reveal scroll-mt-28 rounded-2xl p-8 sm:p-9", i % 2 === 1 && "lg:mt-10"]}>
            <div class="flex items-start justify-between">
              <div class="flex items-center gap-4">
                <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-steel-50 text-steel-700">
                  <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={s.icon}/></svg>
                </span>
                <h2 class="font-display text-2xl font-bold text-ink-900">{s.title}</h2>
              </div>
              <span class="font-display text-4xl font-bold text-ink-100">{s.n}</span>
            </div>
            <p class="mt-5 leading-relaxed text-ink-600">{s.lead}</p>
            <ul class="mt-5 flex flex-wrap gap-2">
              {s.apps.map((app) => (
                <li class="spec-chip rounded-full px-3 py-1.5 text-xs font-semibold">{app}</li>
              ))}
            </ul>
            <a href="/contacto" class="mt-6 inline-flex cursor-pointer items-center gap-1.5 text-sm font-bold text-oil-700 hover:text-oil-600">
              Hablar sobre este sector
              <svg viewBox="0 0 20 20" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L11.29 6.16a.75.75 0 1 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 1 1-1.06-1.06l3.098-3.09H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/></svg>
            </a>
          </section>
        ))}
      </div>
    </div>

    <section class="noise relative overflow-hidden border-y border-ink-900/10 bg-steel-50 py-24">
      <div class="absolute inset-0 dot-grid opacity-70" aria-hidden="true"></div>
      <div class="relative z-10 mx-auto max-w-4xl px-6 text-center" data-reveal-group>
        <span class="reveal font-mono text-xs font-bold uppercase tracking-[0.2em] text-oil-600">/ Aplicación destacada</span>
        <h2 class="reveal mt-4 font-display text-4xl font-bold leading-tight text-ink-900 text-balance sm:text-5xl">Kit hidráulico forestal</h2>
        <p class="reveal mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-ink-600">
          Válvula de comando monoblock, válvula de seguridad anti-ruptura, válvulas de cartucho, rotadores y piezas de reposición, con respaldo de marcas como Sun Hydraulics, Badestnost y CBF Hydraulic.
        </p>
      </div>
    </section>

    <section class="bg-paper py-24">
      <div class="mx-auto max-w-4xl px-6 text-center" data-reveal-group>
        <h2 class="reveal font-display text-4xl font-bold leading-tight text-ink-900 text-balance sm:text-5xl">¿No encuentra su sector?</h2>
        <p class="reveal mx-auto mt-4 max-w-xl text-lg text-ink-600">Atendemos maquinaria óleo-hidráulica de diversas industrias en el Valle del Cauca.</p>
        <a href="/contacto" class="reveal mt-8 inline-block cursor-pointer rounded-lg bg-oil-500 px-7 py-4 text-sm font-bold text-ink-950 shadow-glow transition-colors hover:bg-oil-400">Contáctenos</a>
      </div>
    </section>
  </main>
</Layout>
