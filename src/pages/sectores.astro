---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SteelBanner from '../components/SteelBanner.astro';
import { figures } from '../data/company';

const sectors = [
  {
    id: 'industrial', n: '01', title: 'Industrial',
    lead: 'Sistemas óleo-hidráulicos para líneas de producción y procesos.',
    apps: ['Inyección de plásticos', 'Siderúrgica', 'Pulpa de papel y convertidoras', 'Industria metalúrgica', 'Industria química', 'Alimentos y bebidas', 'Automotriz', 'Petrolera'],
    icon: 'M4 21V9l8-6 8 6v12M9 21v-6h6v6',
  },
  {
    id: 'agricola', n: '02', title: 'Agrícola',
    lead: 'Mantenimiento y reparación para la maquinaria del campo.',
    apps: ['Tractores', 'Cosechadoras', 'Pulverizadoras', 'Máquinas e implementos agrícolas en general'],
    icon: 'M12 3v9m0 0-3.5-3.5M12 12l3.5-3.5M5 21c0-4 3-7 7-7s7 3 7 7',
  },
  {
    id: 'construccion-mineria', n: '03', title: 'Construcción y minería',
    lead: 'Soporte para los equipos de mayor exigencia de presión y ciclo de trabajo.',
    apps: ['Construcción civil', 'Manipulación de carga', 'Máquinas viales', 'Equipos mineros'],
    icon: 'M3 21h18M6 21V10l6-5 6 5v11M10 21v-6h4v6',
  },
  {
    id: 'forestal', n: '04', title: 'Forestal',
    lead: 'Kits hidráulicos y rotadores para el trabajo forestal.',
    apps: ['Cargadores forestales', 'Excavadoras forestales', 'Arrastradores', 'Forwarders', 'Cabezales y rotativos Baltrotors (1–16 toneladas)'],
    icon: 'M12 3 6 12h3l-4 6h5v3h4v-3h5l-4-6h3L12 3Z',
  },
  {
    id: 'portuaria-offshore', n: '05', title: 'Portuaria / Offshore',
    lead: 'Sistemas para operación marítima y petrolera.',
    apps: ['Plataformas offshore', 'Grúas', 'Industria petrolera', 'Aplicaciones portuarias varias'],
    icon: 'M3 20h18M4 20V9l4-2 4 2 4-2 4 2v11M8 12h.01M14 12h.01',
  },
  {
    id: 'manipulacion-cargas', n: '06', title: 'Manipulación de cargas',
    lead: 'Cilindros y centrales hidráulicas para equipos de elevación y traslado.',
    apps: ['Gatos hidráulicos', 'Mesas pantográficas', 'Elevadores', 'Apiladores', 'Canastas aéreas'],
    icon: 'M4 16h16M6 16V8h4v8M14 16V5h4v11',
  },
];

// Reglas CSS generadas por sector (radio-tabs sin JS): botón activo + panel visible.
const tabCss = sectors
  .map(
    (s) => `
    #tab-${s.id}:checked ~ .switch-grid [data-btn="${s.id}"] { background-color: var(--color-oil-500); border-color: var(--color-oil-400); color: var(--color-ink-950); }
    #tab-${s.id}:checked ~ .switch-grid [data-btn="${s.id}"] .btn-icon { background-color: rgb(8 13 19 / 0.14); color: var(--color-ink-950); }
    #tab-${s.id}:checked ~ .switch-grid [data-btn="${s.id}"] .font-display { color: var(--color-ink-950); }
    #tab-${s.id}:checked ~ .frame-corners [data-panel="${s.id}"] { display: grid; }
    #tab-${s.id}:focus-visible ~ .switch-grid [data-btn="${s.id}"] { outline: 2px solid var(--color-oil-400); outline-offset: 2px; }
    #tab-${s.id}:checked ~ .carousel-dots [data-dot="${s.id}"] { background-color: var(--color-oil-400); width: 1.1rem; border-radius: 9999px; }
  `,
  )
  .join('\n');
---

<Layout
  title="Sectores atendidos | Diesel Ingeniería"
  description="Sistemas óleo-hidráulicos para los sectores industrial, agrícola, construcción, minería, forestal, portuario/offshore y manipulación de cargas en Colombia."
  path="/sectores"
>
  <main>
    <PageHero
      kicker="Sectores"
      title="Donde se mueve la industria colombiana"
      lead="Cada sector exige su propio criterio de presión, ciclo y ambiente de trabajo. Adaptamos diagnóstico, reparación y fabricación a la realidad de cada máquina."
      watermark="SECTORES"
    />

    <!-- ============ PANEL DE CONTROL — SELECTOR DE SECTORES ============ -->
    <SteelBanner>
        <div class="reveal flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div class="max-w-2xl">
            <span class="inline-flex items-center gap-2.5 rounded-full border border-oil-400/30 bg-oil-500/10 px-4 py-1.5 font-mono text-xs font-bold uppercase tracking-[0.2em] text-oil-400">
              <span class="h-1.5 w-1.5 rounded-full bg-oil-400"></span>
              Panel de sectores
            </span>
            <h2 class="mt-5 font-display text-4xl font-bold leading-tight text-white text-balance sm:text-5xl">Seleccione un sector</h2>
          </div>
          <p class="max-w-sm font-mono text-sm text-steel-200/70">{sectors.length} sectores atendidos · {figures.years} años de trayectoria en sistemas óleo-hidráulicos.</p>
        </div>

        <!-- Selector radio (sin JS): array de botones tipo panel de control -->
        <div class="reveal relative mt-10">
          {sectors.map((s, i) => (
            <input type="radio" name="sector-tab" id={`tab-${s.id}`} class="sr-only" checked={i === 0} />
          ))}

          <div class="switch-grid -mx-6 flex snap-x snap-mandatory gap-3 overflow-x-auto px-6 pb-1 sm:mx-0 sm:grid sm:grid-cols-3 sm:gap-3 sm:overflow-visible sm:px-0 sm:pb-0 lg:grid-cols-6">
            {sectors.map((s) => (
              <label for={`tab-${s.id}`} data-btn={s.id} class="switch-btn relative flex w-[40%] shrink-0 cursor-pointer snap-center flex-col items-center gap-3 rounded-xl border border-white/25 bg-white/[0.09] px-4 py-6 text-center shadow-[0_1px_0_0_rgb(255_255_255_/_0.06)_inset] transition-colors duration-200 sm:w-auto sm:shrink">
                <span class="btn-icon flex h-11 w-11 items-center justify-center rounded-lg bg-white/10 text-oil-400 transition-colors duration-200">
                  <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={s.icon}/></svg>
                </span>
                <span class="font-display text-sm font-bold leading-tight text-white">{s.title}</span>
              </label>
            ))}
          </div>

          <!-- Indicador de posición del carrusel (solo mobile) -->
          <div class="carousel-dots mt-4 flex justify-center gap-1.5 sm:hidden" aria-hidden="true">
            {sectors.map((s) => (
              <span data-dot={s.id} class="dot h-1.5 w-1.5 rounded-full bg-white/20 transition-colors duration-200"></span>
            ))}
          </div>

          <div class="frame-corners relative mt-4 overflow-hidden rounded-2xl border border-white/15 bg-white/[0.03]">
            <span class="corner corner-tl" aria-hidden="true"></span>
            <span class="corner corner-tr" aria-hidden="true"></span>
            <span class="corner corner-bl" aria-hidden="true"></span>
            <span class="corner corner-br" aria-hidden="true"></span>

            {sectors.map((s) => (
              <div data-panel={s.id} class="sector-panel relative hidden w-full grid-cols-1 md:grid-cols-[1fr_1.15fr]">
                <div class="flex flex-col justify-between p-8 sm:p-10">
                  <div>
                    <span class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-oil-400">Sector / {s.n}</span>
                    <h3 class="mt-2 font-display text-2xl font-bold leading-tight text-white sm:text-3xl">{s.title}</h3>
                    <p class="mt-4 leading-relaxed text-steel-200/85">{s.lead}</p>
                  </div>
                  <a href="/contacto" class="mt-8 inline-flex w-fit cursor-pointer items-center gap-1.5 text-sm font-bold text-oil-400 hover:text-oil-300">
                    Hablar sobre este sector
                    <svg viewBox="0 0 20 20" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L11.29 6.16a.75.75 0 1 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 1 1-1.06-1.06l3.098-3.09H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/></svg>
                  </a>
                </div>

                <div class="flex flex-col justify-center border-t border-white/10 bg-black/15 p-8 sm:p-10 md:border-l md:border-t-0">
                  <span class="font-mono text-[11px] font-bold uppercase tracking-[0.18em] text-white/40">Aplicaciones típicas</span>
                  <ul class="mt-3 grid grid-cols-1 gap-x-6 gap-y-2.5 sm:grid-cols-2">
                    {s.apps.map((app) => (
                      <li class="flex items-center gap-2.5 text-sm font-medium text-steel-100/90">
                        <svg viewBox="0 0 20 20" class="h-4 w-4 shrink-0 text-oil-400" fill="currentColor" aria-hidden="true"><path d="M9 12.75 6.75 10.5l-1.5 1.5L9 15.75l7.5-7.5-1.5-1.5L9 12.75Z"/></svg>
                        {app}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            ))}
          </div>
        </div>
    </SteelBanner>

    <!-- ============ CASO DESTACADO ============ -->
    <section class="noise relative overflow-hidden border-y border-ink-900/10 bg-steel-50 py-24">
      <div class="absolute inset-0 dot-grid opacity-70" aria-hidden="true"></div>
      <div class="relative z-10 mx-auto max-w-4xl px-6 text-center" data-reveal-group>
        <span class="reveal font-mono text-xs font-bold uppercase tracking-[0.2em] text-oil-600">/ Aplicación destacada — Sector forestal</span>
        <h2 class="reveal mt-4 font-display text-4xl font-bold leading-tight text-ink-900 text-balance sm:text-5xl">Kit hidráulico forestal</h2>
        <p class="reveal mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-ink-600">
          Válvula de comando monoblock, válvula de seguridad anti-ruptura, válvulas de cartucho, rotadores y piezas de reposición para equipos forestales.
        </p>
        <ul class="reveal mt-6 flex flex-wrap justify-center gap-2">
          {['Sun Hydraulics', 'Badestnost', 'CBF Hydraulic'].map((brand) => (
            <li class="spec-chip rounded-full px-3 py-1.5 text-xs font-semibold">{brand}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class="bg-paper py-24">
      <div class="mx-auto max-w-4xl px-6 text-center" data-reveal-group>
        <h2 class="reveal font-display text-4xl font-bold leading-tight text-ink-900 text-balance sm:text-5xl">¿No encuentra su sector?</h2>
        <p class="reveal mx-auto mt-4 max-w-xl text-lg text-ink-600">Atendemos maquinaria óleo-hidráulica de diversas industrias en el Valle del Cauca.</p>
        <a href="/contacto" class="reveal mt-8 inline-block cursor-pointer rounded-lg bg-oil-500 px-7 py-4 text-sm font-bold text-ink-950 shadow-glow transition-colors hover:bg-oil-400">Contáctenos</a>
      </div>
    </section>
  </main>
</Layout>

<style set:html={tabCss}></style>

<style>
  .switch-btn:hover {
    border-color: rgb(217 130 43 / 0.5);
    background-color: rgb(255 255 255 / 0.14);
  }

  /* Carrusel de sectores en mobile: sin scrollbar visible, snap suave */
  .switch-grid {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .switch-grid::-webkit-scrollbar {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .switch-grid {
      scroll-behavior: smooth;
    }
  }

  /* Esquinas de plano técnico para el panel de detalle (sobre fondo oscuro) */
  .frame-corners .corner {
    position: absolute;
    width: 1.1rem;
    height: 1.1rem;
    border-color: rgb(236 156 68 / 0.55);
    pointer-events: none;
    z-index: 1;
  }
  .corner-tl { top: 0.75rem; left: 0.75rem; border-top: 2px solid; border-left: 2px solid; }
  .corner-tr { top: 0.75rem; right: 0.75rem; border-top: 2px solid; border-right: 2px solid; }
  .corner-bl { bottom: 0.75rem; left: 0.75rem; border-bottom: 2px solid; border-left: 2px solid; }
  .corner-br { bottom: 0.75rem; right: 0.75rem; border-bottom: 2px solid; border-right: 2px solid; }
</style>
